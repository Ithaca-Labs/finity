{
  "name": "@therick/finityd",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "finityd": "./dist/daemon.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
