{
  "name": "finity",
  "private": true,
  "version": "0.1.0",
  "description": "Ledger-governed commerce network on Hedera",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm -r test && vitest run scripts",
    "lint": "pnpm -r lint",
    "demo": "tsx scripts/demo.ts",
    "provider:weather": "tsx scripts/serve-hello-weather.ts",
    "provider:summarize": "tsx scripts/serve-summarize-lite.ts",
    "registry:seed": "tsx scripts/seed-registry.ts",
    "testnet:bootstrap": "tsx scripts/bootstrap-testnet.ts",
    "testnet:mandate": "tsx scripts/register-ledger-mandate.ts",
    "testnet:paid": "tsx scripts/paid-testnet.ts",
    "finityd": "tsx scripts/finityd-intent.ts"
  },
  "devDependencies": {
    "@finity/finityd": "workspace:*",
    "@finity/hello-weather": "workspace:*",
    "@finity/mandate-compiler": "workspace:*",
    "@finity/pi-package": "workspace:*",
    "@finity/policy-engine": "workspace:*",
    "@finity/provider-sdk": "workspace:*",
    "@finity/registry-client": "workspace:*",
    "@finity/schemas": "workspace:*",
    "@finity/summarize-lite": "workspace:*",
    "@hiero-ledger/sdk": "2.87.0",
    "@types/node": "26.4.1",
    "@x402/fetch": "2.25.0",
    "@x402/hedera": "2.25.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "viem": "2.56.3",
    "vitest": "5.0.0"
  }
}
