# Hedera operator used only by broker/provider scripts; never commit a value.
HEDERA_OPERATOR_ID=
# ECDSA private key for the corresponding Hedera operator account.
HEDERA_OPERATOR_KEY=
# Principal funding account ID used by setup instructions.
FINITY_PRINCIPAL_FUNDING_ACCOUNT=
# Provider A Hedera account ID.
FINITY_PROVIDER_A_ACCOUNT=
# Provider B Hedera account ID.
FINITY_PROVIDER_B_ACCOUNT=
# Broker Spend Account ID.
FINITY_SPEND_ACCOUNT_ID=
# Broker Session Key in the format accepted by the verified SDK.
FINITY_BROKER_SESSION_KEY=
# Broker Session Key EVM address.
FINITY_BROKER_EVM_ADDRESS=
# Mandate Registry EVM address on Hedera testnet.
FINITY_REGISTRY_ADDRESS=
# Finity service registry HCS topic ID.
FINITY_REGISTRY_TOPIC_ID=
# Provider A public base URL.
FINITY_PROVIDER_A_URL=
# Provider A ECDSA private key for signing manifests, quotes, and usage receipts.
# This is provider-owned; it is not the Broker Session Key.
FINITY_PROVIDER_A_SIGNING_EVM_PRIVATE_KEY=
# Provider B public base URL.
FINITY_PROVIDER_B_URL=
# Provider B ECDSA private key for signing manifests, quotes, and usage receipts.
# This is provider-owned; it is not the Broker Session Key.
FINITY_PROVIDER_B_SIGNING_EVM_PRIVATE_KEY=
# Public listening ports for local provider processes. Public URLs above remain
# the externally visible origins included in manifests.
FINITY_PROVIDER_A_PORT=3001
FINITY_PROVIDER_B_PORT=3002
# Blocky402 facilitator base URL; defaults to the verified testnet endpoint.
FINITY_FACILITATOR_URL=https://api.testnet.blocky402.com
# Hedera testnet mirror node base URL.
FINITY_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
# Hashio JSON-RPC relay URL.
FINITY_RPC_URL=https://testnet.hashio.io/api
# Set to 1 only for explicitly gated testnet integration tests.
FINITY_TESTNET=0
# Secret-store lookup is performed by vault-worker; the value is never read by Pi.
WALLET_PASS=
# Optional upstream API key stored in a PAB, never passed directly to the agent.
FINITY_UPSTREAM_API_KEY=
